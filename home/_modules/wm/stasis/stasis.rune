@author "redman"
@description "Idle management via stasis + veila lock screen"

lock_after               300
screen_off_after_lock     60

default:
  enable_loginctl_integration true
  enable_dbus_inhibit true

  monitor_media true
  ignore_remote_media true

  inhibit_apps [
    r"steam_app_.*"
    r".*\.exe"
  ]

  lock_screen:
    timeout lock_after
    command "wm-lock-session"
    notification "Locking in 5s"
    notify_seconds_before 5
  end

  dpms:
    timeout screen_off_after_lock
    command "stasis-dpms off"
    resume_command "stasis-dpms on"
  end
end
